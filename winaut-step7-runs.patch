@@ -0,0 +1,38 @@
+import type {
+  AutomationRunStatus,
+  AutomationStepStatus,
+} from '@winaut/contracts';
+
+type Status = AutomationRunStatus | AutomationStepStatus;
+
+const labels: Record<Status, string> = {
+  PENDING: 'Pendente',
+  RUNNING: 'Em execução',
+  SUCCEEDED: 'Concluída',
+  FAILED: 'Falhou',
+  CANCELLED: 'Cancelada',
+  SKIPPED: 'Ignorada',
+};
+
+const styles: Record<Status, string> = {
